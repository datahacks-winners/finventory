    "chai": "^6.2.2",
    "eslint": "^9.25.0",
    "firebase-admin": "^13.8.0",
    "firebase-functions": "^7.2.5",
    "jest": "^30.0.0",
    "mocha": "^11.7.5",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0",
