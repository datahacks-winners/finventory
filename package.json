{
  "name": "finventory",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:firebase": "firebase emulators:start --only functions,firestore,auth,storage,database",
    "build": "npm run build --workspaces --if-present",
    "deploy": "npm run deploy --workspaces --if-present",
    "test": "npm run lint",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky githooks"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.3.2",
    "stripe": "^17.6.0"
  },
  "devDependencies": {
    "@google-cloud/functions-framework": "^3.5.1",
    "@google-cloud/storage": "^7.15.5",
    "@types/node": "^22.14.1",
    "eslint": "^9.31.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.26.1"
  },
  "optionalDependencies": {
    "@stripe/stripe-react-native": "^0.38.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  }
}
